{
  "name": "VeriFlush rig emulator",
  "author": "Team Gurt (SIMULATED)",
  "pins": ["VCC", "GND", "SERVO", "FLOW", "LS_OPEN", "LS_CLOSED"],
  "controls": [
    { "id": "flowLpm", "label": "Branch flow at full opening (L/min)", "type": "range", "min": 0, "max": 1.5, "step": 0.01 },
    { "id": "valveJam", "label": "XV-101 jams at (fraction open)", "type": "range", "min": 0, "max": 1, "step": 0.05 },
    { "id": "meterBias", "label": "FT-101 bias (x reading)", "type": "range", "min": 0.5, "max": 2, "step": 0.05 },
    { "id": "lsOpenBroken", "label": "LS-OPEN wire broken (0/1)", "type": "range", "min": 0, "max": 1, "step": 1 },
    { "id": "flowDropout", "label": "FT-101 signal dropout (0/1)", "type": "range", "min": 0, "max": 1, "step": 1 }
  ]
}
